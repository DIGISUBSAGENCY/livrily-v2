# URL publique de l'app (utilisée pour construire les liens de redirection
# email — confirmation de compte, etc.). En prod, mettre le vrai domaine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — à récupérer dans Project Settings > API de ton projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Clé service_role — SERVEUR UNIQUEMENT (Server Actions/Route Handlers admin).
# Ne JAMAIS préfixer par NEXT_PUBLIC_, ne jamais l'importer dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Google Maps JavaScript API (cartes + géocodage). Restreindre la clé par domaine/référent HTTP en prod.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Phase 2+ : paiement Flouci (à brancher dans components/payment/PaymentFlouci.tsx) ---
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# --- Phase 5, Module 4 : notifications push (OneSignal) ---
# App ID : public (chargé côté navigateur pour initialiser le SDK Web Push).
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# REST API Key : SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_.
ONESIGNAL_REST_API_KEY=

# --- Phase 5, Module 4 : notifications WhatsApp/SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp Twilio (sandbox ou approuvé), format E.164 sans "whatsapp:".
TWILIO_WHATSAPP_FROM=
# Repli SMS si TWILIO_WHATSAPP_FROM n'est pas configuré (optionnel).
TWILIO_SMS_FROM=
